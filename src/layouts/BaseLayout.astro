---
import SiteNav from '../components/SiteNav.astro';
import PageLoader from '../components/PageLoader.astro';
import '../styles/global.css';
import '../styles/design.css';
import '../styles/page-loader.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Практическая база знаний о Vibe Coding, локальных AI-моделях и работе с AI-агентами' } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <PageLoader />
    <SiteNav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© покодим.рф — научись создавать продукты с AI быстрее, дешевле и системнее</span>
      </div>
    </footer>
    <script>
      import '../scripts/page-loader';
    </script>
  </body>
</html>
