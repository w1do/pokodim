<div class="search">
  <input
    type="search"
    class="search__input"
    data-search-input
    placeholder="Поиск по материалам"
    aria-label="Поиск по материалам"
  />
  <p class="search__empty" data-empty-message hidden>Ничего не найдено</p>
</div>

<script>
  import { applyCatalogFilters } from '../lib/catalog-client';

  document
    .querySelector<HTMLInputElement>('[data-search-input]')
    ?.addEventListener('input', applyCatalogFilters);
</script>

